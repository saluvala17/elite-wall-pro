# Elite Wall Pro - Environment Variables Template
# Copy this to .env and fill in your values
# NEVER commit .env to git

# ============================================
# BACKEND ENVIRONMENT VARIABLES
# ============================================

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# API Security
API_SECRET_KEY=generate-a-secure-random-key-here
API_DEBUG=false

# CORS (comma-separated or JSON array)
CORS_ORIGINS=["https://your-frontend.up.railway.app","http://localhost:8501"]

# Optional: AI Features
ANTHROPIC_API_KEY=sk-ant-xxx

# Rate Limiting (optional)
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# JWT Configuration (optional, has defaults)
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ============================================
# FRONTEND ENVIRONMENT VARIABLES
# ============================================

# Backend API URL
API_URL=https://your-backend.up.railway.app

# Streamlit Configuration (optional)
STREAMLIT_SERVER_PORT=8501
STREAMLIT_THEME_PRIMARY_COLOR=#4A7C59

# ============================================
# LOCAL DEVELOPMENT
# ============================================

# For local development, use these instead:
# API_URL=http://localhost:8000
# CORS_ORIGINS=["http://localhost:8501","http://localhost:3000"]
# API_DEBUG=true

# ============================================
# RAILWAY DEPLOYMENT
# ============================================

# On Railway, set these as environment variables in the dashboard:
# Backend service: All SUPABASE_*, API_*, CORS_*, JWT_* variables
# Frontend service: API_URL variable

# Railway automatically provides:
# - PORT (assigned dynamically)
# - RAILWAY_ENVIRONMENT
# - RAILWAY_SERVICE_NAME

# ============================================
# SECURITY NOTES
# ============================================

# 1. Generate secure API_SECRET_KEY:
#    python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# 2. Never share SUPABASE_SERVICE_KEY publicly
#
# 3. Update CORS_ORIGINS to match your actual domain
#
# 4. Use strong passwords for Supabase
#
# 5. Enable MFA on Railway and Supabase accounts

# ============================================
# OPTIONAL FEATURES
# ============================================

# OpenAI (if using AI features)
# OPENAI_API_KEY=sk-xxx

# SendGrid (if using email)
# SENDGRID_API_KEY=SG.xxx

# S3 Storage (if using file uploads)
# AWS_ACCESS_KEY_ID=xxx
# AWS_SECRET_ACCESS_KEY=xxx
# AWS_REGION=us-east-1
# AWS_BUCKET_NAME=elite-wall-pro
